{
  "version": 1,
  "audit": {
    "timeoutMs": 180000,
    "checks": [
      {
        "id": "acceptance",
        "title": "Frozen scene-core acceptance",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/agent/test_scene_refactor.py",
          "tests/agent/test_scene_private_disabled.py",
          "tests/quality/test_quality_junit.py",
          "-q",
          "--junitxml=.quality/acceptance.xml"
        ],
        "report": ".quality/acceptance.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Acceptance cases",
            "path": "tests",
            "min": 35
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "owner-selection",
        "title": "Owner skill exclusion before selection budget",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/agent/test_owner_skill_budget.py",
          "-q",
          "--junitxml=.quality/owner-selection.xml"
        ],
        "report": ".quality/owner-selection.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Owner boundary cases",
            "path": "tests",
            "min": 4
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "branding",
        "title": "Kinna bot public identity and existing CLI compatibility",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/bootstrap/test_branding.py",
          "tests/interfaces/test_webui.py::test_markdown_guide_is_task_oriented_and_covers_every_module",
          "-q",
          "--junitxml=.quality/branding.xml"
        ],
        "report": ".quality/branding.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Branding cases",
            "path": "tests",
            "min": 4
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "project-layout",
        "title": "Canonical source, dependency boundaries, preserved tests and installable wheel",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/quality/test_project_layout.py",
          "-q",
          "--junitxml=.quality/project-layout.xml"
        ],
        "report": ".quality/project-layout.xml",
        "format": "junit",
        "timeoutMs": 180000,
        "metrics": [
          {
            "name": "Layout acceptance cases",
            "path": "tests",
            "min": 20
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "package-identity",
        "title": "QQ Bot package identity and deployment compatibility",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/quality/test_package_identity.py",
          "-q",
          "--junitxml=.quality/package-identity.xml"
        ],
        "report": ".quality/package-identity.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Package identity cases",
            "path": "tests",
            "min": 5
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "quality-integration",
        "title": "Released CQG 0.6.0 provenance and one active integration",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/quality/test_quality_integration.py",
          "-q",
          "--junitxml=.quality/quality-integration.xml"
        ],
        "report": ".quality/quality-integration.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Integration cases",
            "path": "tests",
            "min": 4
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "observation-boundary",
        "title": "Independent post-reply observation lifecycle and service delegation",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/agent/test_observation.py",
          "-q",
          "--junitxml=.quality/observation.xml"
        ],
        "report": ".quality/observation.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Observation cases",
            "path": "tests",
            "min": 18
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "regression",
        "title": "Complete legacy and new Python regression suite",
        "command": [
          ".venv/bin/python",
          "-m",
          "tools.quality.checks",
          "regression"
        ],
        "report": ".quality/regression.xml",
        "format": "junit",
        "timeoutMs": 180000,
        "metrics": [
          {
            "name": "Regression cases",
            "path": "tests",
            "min": 1202
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "lint",
        "title": "Ruff syntax and correctness across changed Python modules",
        "command": [
          ".venv/bin/python",
          "-m",
          "tools.quality.checks",
          "lint"
        ]
      },
      {
        "id": "architecture",
        "title": "Import-linter ownership contracts",
        "command": [
          ".venv/bin/python",
          "-m",
          "tools.quality.checks",
          "architecture"
        ]
      },
      {
        "id": "coverage",
        "title": "New module line and branch coverage",
        "command": [
          ".venv/bin/python",
          "-m",
          "tools.quality.checks",
          "coverage"
        ],
        "report": ".quality/coverage-metrics.json",
        "format": "json",
        "metrics": [
          {
            "name": "Line coverage",
            "path": "lineCoverage",
            "min": 90
          },
          {
            "name": "Branch coverage",
            "path": "branchCoverage",
            "min": 80
          },
          {
            "name": "Statements",
            "path": "statements",
            "min": 20
          },
          {
            "name": "Branches",
            "path": "branches",
            "min": 10
          }
        ]
      },
      {
        "id": "observation-coverage",
        "title": "Observation module measured line and branch coverage",
        "command": [
          ".venv/bin/python",
          "-m",
          "tools.quality.checks",
          "observation-coverage"
        ],
        "report": ".quality/observation-coverage-metrics.json",
        "format": "json",
        "metrics": [
          {
            "name": "Line coverage",
            "path": "lineCoverage",
            "min": 90
          },
          {
            "name": "Branch coverage",
            "path": "branchCoverage",
            "min": 80
          },
          {
            "name": "Statements",
            "path": "statements",
            "min": 100
          },
          {
            "name": "Branches",
            "path": "branches",
            "min": 40
          }
        ]
      }
    ]
  }
}
