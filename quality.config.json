{
  "version": 1,
  "audit": {
    "timeoutMs": 180000,
    "checks": [
      {
        "id": "acceptance",
        "title": "Frozen scene-core acceptance",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/test_scene_refactor.py",
          "tests/test_scene_private_disabled.py",
          "tests/test_quality_junit.py",
          "-q",
          "--junitxml=.quality/acceptance.xml"
        ],
        "report": ".quality/acceptance.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Acceptance cases",
            "path": "tests",
            "min": 35
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "owner-selection",
        "title": "Owner skill exclusion before selection budget",
        "command": [
          ".venv/bin/python",
          "-m",
          "pytest",
          "tests/test_owner_skill_budget.py",
          "-q",
          "--junitxml=.quality/owner-selection.xml"
        ],
        "report": ".quality/owner-selection.xml",
        "format": "junit",
        "metrics": [
          {
            "name": "Owner boundary cases",
            "path": "tests",
            "min": 4
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "regression",
        "title": "Complete legacy and new Python regression suite",
        "command": [
          ".venv/bin/python",
          "scripts/quality_adapter.py",
          "regression"
        ],
        "report": ".quality/regression.xml",
        "format": "junit",
        "timeoutMs": 180000,
        "metrics": [
          {
            "name": "Regression cases",
            "path": "tests",
            "min": 1202
          },
          {
            "name": "Success rate",
            "path": "successRate",
            "equals": 100
          },
          {
            "name": "Skipped",
            "path": "skipped",
            "equals": 0
          }
        ]
      },
      {
        "id": "lint",
        "title": "Ruff syntax and correctness across changed Python modules",
        "command": [
          ".venv/bin/python",
          "scripts/quality_adapter.py",
          "lint"
        ]
      },
      {
        "id": "architecture",
        "title": "Import-linter ownership contracts",
        "command": [
          ".venv/bin/python",
          "scripts/quality_adapter.py",
          "architecture"
        ]
      },
      {
        "id": "coverage",
        "title": "New module line and branch coverage",
        "command": [
          ".venv/bin/python",
          "scripts/quality_adapter.py",
          "coverage"
        ],
        "report": ".quality/coverage-metrics.json",
        "format": "json",
        "metrics": [
          {
            "name": "Line coverage",
            "path": "lineCoverage",
            "min": 90
          },
          {
            "name": "Branch coverage",
            "path": "branchCoverage",
            "min": 80
          },
          {
            "name": "Statements",
            "path": "statements",
            "min": 20
          },
          {
            "name": "Branches",
            "path": "branches",
            "min": 10
          }
        ]
      }
    ]
  }
}
