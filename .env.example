BOT_MODEL_BASE_URL=http://216.167.7.16:8080/v1
BOT_MODEL_API_KEY=replace-with-rotated-model-key
BOT_MODEL_NAME=grok
BOT_ONEBOT_HOST=127.0.0.1
BOT_ONEBOT_PORT=6199
BOT_ONEBOT_TOKEN=replace-with-a-long-random-token
BOT_DB_PATH=./data/qunbot.sqlite3
BOT_GROUP_ALLOWLIST=123456789
BOT_PRIVATE_ENABLED=false
# Add proactive_chat to BOT_EXTENSIONS to enable random proactive continuation.
BOT_PROACTIVE_INTERVAL_MINUTES=180
BOT_PROACTIVE_DAILY_LIMIT=2
BOT_MEMORY_EXTRACT_EVERY=8
BOT_AFFECTION_AUTO_ENABLED=true
BOT_TIMEZONE=Asia/Shanghai
BOT_EXTENSIONS=scheduled_chat,exam_poster,memes,mood

# The bot's own mood (qunbot/emotion/). Values relax toward a neutral baseline
# with this half-life, so the bot wakes up calm rather than mid-grudge.
# Set BOT_MOOD_DB_PATH to ./data/qunbot.sqlite3 to keep one database file.
BOT_MOOD_ENABLED=true
BOT_MOOD_AUTO_ENABLED=true
BOT_MOOD_DB_PATH=./data/emotion.sqlite3
BOT_MOOD_DECAY_MINUTES=180
BOT_MOOD_SENSITIVITY=1.0
BOT_MOOD_PROACTIVE_MIN_SOCIABILITY=35

# Scheduled posts (config/schedules.json). Separate quota from
# BOT_PROACTIVE_DAILY_LIMIT so random chat and cron jobs cannot starve each other.
BOT_JOB_DAILY_LIMIT=6
BOT_JOB_COOLDOWN_MINUTES=30
BOT_JOB_FRESHNESS_MINUTES=180
BOT_JOB_MAX_CHARS=150
BOT_ACTIVE_START_HOUR=7
BOT_ACTIVE_END_HOUR=23

# Backpressure. The bot has two queues, both bounded, both dropping-and-counting
# rather than growing without limit. Inbound frames are dispatched one serial
# lane per group so a busy group cannot interleave its own replies; the
# observation queue carries post-reply affection/mood assessment, which is
# advisory and at-most-once.
BOT_ONEBOT_INBOUND_BACKLOG=64
BOT_ONEBOT_MAX_LANES=32
BOT_ONEBOT_REQUEST_TIMEOUT=20.0
BOT_ONEBOT_MAX_FRAME_KB=1024
BOT_OBSERVER_QUEUE_SIZE=256
BOT_OBSERVER_WORKERS=1
BOT_OBSERVER_DEDUPE=4096

# Long-term memory (qunbot/memory/). Leave the provider empty for lexical-only
# retrieval — the bot starts and recalls fine without any embedding service.
# "hash" is a local, dependency-free provider for smoke-testing the vector path.
# The openai provider calls an OpenAI-compatible /embeddings endpoint.
BOT_MEMORY_EMBEDDING_PROVIDER=
BOT_MEMORY_EMBEDDING_BASE_URL=
BOT_MEMORY_EMBEDDING_API_KEY=
BOT_MEMORY_EMBEDDING_MODEL=
BOT_MEMORY_EMBEDDING_DIM=256

# Required by jobs with "action":"poster". Also used to draw the countdown.
BOT_EXAM_DATE=2026-12-19
BOT_POSTER_FONT=

BOT_PERSONA_PATH=./config/persona.md
BOT_SCHEDULES_PATH=./config/schedules.json
BOT_MEMES_PATH=./memes
BOT_TTS_PROVIDER=dashscope
# Add voice to BOT_EXTENSIONS to enable speech; no client exists while disabled.
BOT_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BOT_TTS_API_KEY=replace-with-rotated-dashscope-key
BOT_TTS_MODEL=qwen3-tts-flash
BOT_TTS_VOICE=Cherry
