BOT_MODEL_BASE_URL=http://216.167.7.16:8080/v1
BOT_MODEL_API_KEY=replace-with-rotated-model-key
BOT_MODEL_NAME=grok
BOT_ONEBOT_HOST=127.0.0.1
BOT_ONEBOT_PORT=6199
BOT_ONEBOT_TOKEN=replace-with-a-long-random-token
BOT_DB_PATH=./data/qunbot.sqlite3
BOT_GROUP_ALLOWLIST=123456789
BOT_PRIVATE_ENABLED=false
# Post-message interval continuation ("X minutes after the last message").
# Two trigger paths share this configuration and the same persisted quiet
# window, so enabling both cannot make the bot post twice:
#   * BOT_EXTENSIONS=proactive_chat  → an in-process tick every CHECK_SECONDS
#   * BOT_EXTENSIONS=scheduled_chat  → the seeded, disabled-by-default
#     "continue-quiet" every-job (action "continuation") in schedules.json
# Add proactive_chat to BOT_EXTENSIONS to enable the extension at all.
BOT_PROACTIVE_ENABLED=true
BOT_PROACTIVE_INTERVAL_MINUTES=180
BOT_PROACTIVE_DAILY_LIMIT=2
# How long the group must be silent before a continuation is considered, and
# how stale the recent chatter may get before the window is abandoned.
BOT_PROACTIVE_QUIET_MINUTES=12
BOT_PROACTIVE_FRESHNESS_MINUTES=180
# Minimum gap between two attempts inside one quiet window. Each consecutive
# silent decision lengthens it, capped by the freshness window.
BOT_PROACTIVE_RETRY_MINUTES=30
# Chance of speaking once every other gate has passed (0..1). This is not the
# content decision: the model may still answer "nothing to say".
BOT_PROACTIVE_PROBABILITY=0.15
BOT_PROACTIVE_MIN_MESSAGES=3
BOT_PROACTIVE_MAX_CHARS=150
# Deployment-wide do-not-disturb hours. Per-group overrides live in the local
# file below; nothing here is reachable from chat.
BOT_PROACTIVE_QUIET_START_HOUR=23
BOT_PROACTIVE_QUIET_END_HOUR=8
# How often a quiet window is re-evaluated. The scheduler's "every" kind has a
# 300 second floor, so values below that are raised to it.
BOT_PROACTIVE_CHECK_SECONDS=300
# Local per-group policy file. Missing file = every group uses the defaults
# above. Shape: qunbot/extensions/scheduled_chat/data/proactive_groups.example.json
BOT_PROACTIVE_GROUPS_PATH=./config/proactive_groups.json
BOT_MEMORY_EXTRACT_EVERY=8
BOT_AFFECTION_AUTO_ENABLED=true
BOT_TIMEZONE=Asia/Shanghai
BOT_EXTENSIONS=scheduled_chat,exam_poster,memes,mood

# The bot's own mood (qunbot/emotion/). Values relax toward a neutral baseline
# with this half-life, so the bot wakes up calm rather than mid-grudge.
# Set BOT_MOOD_DB_PATH to ./data/qunbot.sqlite3 to keep one database file.
# BOT_MOOD_COUPLING scales how strongly the five dimensions drag each other.
# 1.0 is the shipped feel; with it, a chatty group (an event every few minutes
# against this half-life) makes the mood latch at an extreme rather than hover
# near the baseline. Set it to 0 for a mood that always relaxes — see
# EmotionPolicy/loop_gain and tests/test_emotion.py::CalibrationTests.
BOT_MOOD_ENABLED=true
BOT_MOOD_AUTO_ENABLED=true
BOT_MOOD_DB_PATH=./data/emotion.sqlite3
BOT_MOOD_DECAY_MINUTES=180
BOT_MOOD_SENSITIVITY=1.0
BOT_MOOD_PROACTIVE_MIN_SOCIABILITY=35
BOT_MOOD_COUPLING=1.0

# Scheduled posts (config/schedules.json). Separate quota from
# BOT_PROACTIVE_DAILY_LIMIT so random chat and cron jobs cannot starve each other.
BOT_JOB_DAILY_LIMIT=6
BOT_JOB_COOLDOWN_MINUTES=30
BOT_JOB_FRESHNESS_MINUTES=180
BOT_JOB_MAX_CHARS=150
BOT_ACTIVE_START_HOUR=7
BOT_ACTIVE_END_HOUR=23

# Backpressure. The bot has two queues, both bounded, both dropping-and-counting
# rather than growing without limit. Inbound frames are dispatched one serial
# lane per group so a busy group cannot interleave its own replies; the
# observation queue carries post-reply affection/mood assessment, which is
# advisory and at-most-once.
BOT_ONEBOT_INBOUND_BACKLOG=64
BOT_ONEBOT_MAX_LANES=32
BOT_ONEBOT_REQUEST_TIMEOUT=20.0
BOT_ONEBOT_MAX_FRAME_KB=1024
BOT_OBSERVER_QUEUE_SIZE=256
BOT_OBSERVER_WORKERS=1
BOT_OBSERVER_DEDUPE=4096

# Long-term memory (qunbot/memory/). Leave the provider empty for lexical-only
# retrieval — the bot starts and recalls fine without any embedding service.
# "hash" is a local, dependency-free provider for smoke-testing the vector path.
# The openai provider calls an OpenAI-compatible /embeddings endpoint.
BOT_MEMORY_EMBEDDING_PROVIDER=
BOT_MEMORY_EMBEDDING_BASE_URL=
BOT_MEMORY_EMBEDDING_API_KEY=
BOT_MEMORY_EMBEDDING_MODEL=
BOT_MEMORY_EMBEDDING_DIM=256

# ---------------------------------------------------------------------------
# Optional behaviour extensions. Each needs its name in BOT_EXTENSIONS *and*
# its own enabled flag; every one of them is off by default and the bot runs
# normally without any of them. See docs/FEATURES.md for what each does.
# ---------------------------------------------------------------------------

# Per-turn phrasing hint (qunbot/extensions/persona/). Never touches
# config/persona.md; expires on its own and falls back to the baseline voice.
BOT_PERSONA_ENABLED=false
BOT_PERSONA_TTL_MINUTES=30

# Reply decision (qunbot/extensions/reply_policy/). Off = answer only when
# @-ed. "mention_only" is the same rule expressed as a policy; "room" reads
# the room and abstains far more often.
BOT_REPLY_POLICY_ENABLED=false
BOT_REPLY_POLICY_MODE=mention_only
BOT_REPLY_POLICY_THRESHOLD=0.5
BOT_REPLY_POLICY_COOLDOWN_SECONDS=20
BOT_REPLY_POLICY_ENGAGED_SECONDS=600
BOT_REPLY_POLICY_BURST_SECONDS=20
BOT_REPLY_POLICY_BURST_COUNT=5
BOT_REPLY_POLICY_CROWD_SPEAKERS=3
BOT_REPLY_POLICY_BOT_NAMES=

# Group slang (qunbot/extensions/slang/). Learns this group's own vocabulary
# from reading it; learning from untrusted group text is off by default.
# Reviewing happens in a local file, never through chat.
BOT_SLANG_ENABLED=false
BOT_SLANG_SCAN_INTERVAL_SECONDS=900
BOT_SLANG_WINDOW_MESSAGES=200
BOT_SLANG_MIN_OCCURRENCES=2
BOT_SLANG_MAX_TERM_CHARS=12
BOT_SLANG_MAX_NGRAM=4
BOT_SLANG_MAX_CANDIDATES=400
BOT_SLANG_MAX_MESSAGE_CHARS=200
BOT_SLANG_MAX_SAMPLES=5
BOT_SLANG_MAX_TERMS=24
BOT_SLANG_UNDERSTAND_CONFIDENCE=0.5
BOT_SLANG_IMITATE_CONFIDENCE=0.75
BOT_SLANG_ALLOW_UNREVIEWED=false
BOT_SLANG_ALLOW_IMITATION=false
BOT_SLANG_REVIEW_PATH=./config/slang_review.json
BOT_SLANG_WORDLIST_PATH=

# World perception (qunbot/extensions/world_context/). Three independent
# providers; the clock needs nothing, weather needs a key and is skipped
# entirely without one, replay reads memories through the memory port.
BOT_WORLD_TIME_ENABLED=false
BOT_WORLD_TIMEZONE=
BOT_WORLD_WEATHER_ENABLED=false
BOT_WORLD_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
BOT_WORLD_WEATHER_API_KEY=
BOT_WORLD_WEATHER_CITY=
BOT_WORLD_WEATHER_REFRESH_MINUTES=30
BOT_WORLD_WEATHER_TIMEOUT_SECONDS=5.0
BOT_WORLD_REPLAY_ENABLED=false
BOT_WORLD_REPLAY_LIMIT=3

# Expression style (qunbot/extensions/style_echo/). Collects nothing until the
# deployer names the users who agreed to it. Consent is a deployment decision,
# never something a group member can grant by typing.
BOT_STYLE_ECHO_ENABLED=false
BOT_STYLE_ECHO_ALLOWED_USERS=
BOT_STYLE_ECHO_MAX_SAMPLES=40
BOT_STYLE_ECHO_MIN_SAMPLES=5
BOT_STYLE_ECHO_POLL_SECONDS=120
BOT_STYLE_ECHO_RETENTION_DAYS=30

# Required by jobs with "action":"poster". Also used to draw the countdown.
BOT_EXAM_DATE=2026-12-19
BOT_POSTER_FONT=

# Outbound media limits. An oversized image is dropped and the text still
# goes out; a reply never fails because an attachment was too big.
BOT_MEDIA_MAX_IMAGE_BYTES=4194304
BOT_MEDIA_MAX_URL_CHARS=2048

BOT_SKILLS_PATH=./skills
BOT_PERSONA_PATH=./config/persona.md
BOT_SCHEDULES_PATH=./config/schedules.json
BOT_MEMES_PATH=./memes
BOT_TTS_PROVIDER=dashscope
# Add voice to BOT_EXTENSIONS to enable speech; no client exists while disabled.
BOT_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BOT_TTS_API_KEY=replace-with-rotated-dashscope-key
BOT_TTS_MODEL=qwen3-tts-flash
BOT_TTS_VOICE=Cherry
