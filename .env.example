BOT_MODEL_BASE_URL=https://your-provider.example/v1
BOT_MODEL_API_KEY=replace-with-your-model-key
BOT_MODEL_NAME=your-chat-model
# Reasoning budget: minimal | low | medium | high, or empty to send no field.
# Leave empty unless the provider supports this setting. Reasoning-capable
# models can spend more time and tokens thinking; measure with your provider
# before increasing the budget for group chat.
BOT_MODEL_REASONING_EFFORT=
BOT_ONEBOT_HOST=127.0.0.1
BOT_ONEBOT_PORT=6199
BOT_ONEBOT_TOKEN=replace-with-a-long-random-token
BOT_DB_PATH=./data/qunbot.sqlite3
BOT_GROUP_ALLOWLIST=123456789
BOT_PRIVATE_ENABLED=false
# Post-message interval continuation ("X minutes after the last message").
# Two trigger paths share this configuration and the same persisted quiet
# window, so enabling both cannot make the bot post twice:
#   * BOT_EXTENSIONS=proactive_chat  → an in-process tick every CHECK_SECONDS
#   * BOT_EXTENSIONS=scheduled_chat  → the seeded, disabled-by-default
#     "continue-quiet" every-job (action "continuation") in schedules.json
# Add proactive_chat to BOT_EXTENSIONS to enable the extension at all.
BOT_PROACTIVE_ENABLED=true
BOT_PROACTIVE_INTERVAL_MINUTES=180
BOT_PROACTIVE_DAILY_LIMIT=2
# How long the group must be silent before a continuation is considered, and
# how stale the recent chatter may get before the window is abandoned.
BOT_PROACTIVE_QUIET_MINUTES=12
BOT_PROACTIVE_FRESHNESS_MINUTES=180
# Minimum gap between two attempts inside one quiet window. Each consecutive
# silent decision lengthens it, capped by the freshness window.
BOT_PROACTIVE_RETRY_MINUTES=30
# Chance of speaking once every other gate has passed (0..1). This is not the
# content decision: the model may still answer "nothing to say".
BOT_PROACTIVE_PROBABILITY=0.15
BOT_PROACTIVE_MIN_MESSAGES=3
BOT_PROACTIVE_MAX_CHARS=150
# Deployment-wide do-not-disturb hours. Per-group overrides live in the local
# file below; nothing here is reachable from chat.
BOT_PROACTIVE_QUIET_START_HOUR=23
BOT_PROACTIVE_QUIET_END_HOUR=8
# How often a quiet window is re-evaluated. The scheduler's "every" kind has a
# 300 second floor, so values below that are raised to it.
BOT_PROACTIVE_CHECK_SECONDS=300
# Local per-group policy file. Missing file = every group uses the defaults
# above. Shape: qunbot/extensions/scheduled_chat/data/proactive_groups.example.json
BOT_PROACTIVE_GROUPS_PATH=./config/proactive_groups.json
BOT_MEMORY_EXTRACT_EVERY=8
# Entity/relation extraction (qunbot/memory/graph.py). Off by default, and
# nothing reads the result into a prompt yet: the store is built first so that
# whether it is worth its cost can be decided from real data rather than from
# a design document. Enabling it costs two model calls per new passage.
BOT_MEMORY_GRAPH_ENABLED=false
BOT_MEMORY_GRAPH_MAX_ENTITIES=20
BOT_MEMORY_GRAPH_MAX_TRIPLES=30
# 当前回复优先读取的连续群聊窗口：消息数、时间跨度和字符预算三重上限。
# Topic 仅作为长期背景提示，不会替代这个短期窗口。
BOT_CONVERSATION_WINDOW_MESSAGES=40
BOT_CONVERSATION_WINDOW_SECONDS=300
BOT_CONVERSATION_WINDOW_CHARS=4800
BOT_AFFECTION_AUTO_ENABLED=true
# Dormancy decay: a relationship nobody has touched for 14 days starts moving
# back toward neutral, halving every N seconds. 0 (the default) disables it —
# a score that drifts down on its own changes how the bot treats someone who
# has done nothing, which is the deployer's call rather than a safe default.
# 2592000 = 30 days.
BOT_AFFECTION_DECAY_HALF_LIFE_SECONDS=0
BOT_TIMEZONE=Asia/Shanghai
# Start with mention-only chat and no optional API or poster dependency.
# Enable reply_policy, voice, scheduled_chat or qq_admin after configuring them.
BOT_EXTENSIONS=memes,mood,persona,slang,style_echo,webui

# Owner-only local configuration console. It binds loopback only and refuses
# to start without a dedicated login token. Saved values are written atomically
# to BOT_WEBUI_ENV_PATH and become active after the Bot is restarted.
BOT_WEBUI_ENABLED=true
BOT_WEBUI_HOST=127.0.0.1
BOT_WEBUI_PORT=6200
BOT_WEBUI_TOKEN=replace-with-another-long-random-token
BOT_WEBUI_ENV_PATH=.env

# The bot's own mood (qunbot/emotion/). Values relax toward a neutral baseline
# with this half-life, so the bot wakes up calm rather than mid-grudge.
# Set BOT_MOOD_DB_PATH to ./data/qunbot.sqlite3 to keep one database file.
# BOT_MOOD_COUPLING scales how strongly the five dimensions drag each other.
# 1.0 is the shipped feel; with it, a chatty group (an event every few minutes
# against this half-life) makes the mood latch at an extreme rather than hover
# near the baseline. Set it to 0 for a mood that always relaxes — see
# EmotionPolicy/loop_gain and tests/test_emotion.py::CalibrationTests.
BOT_MOOD_ENABLED=true
BOT_MOOD_AUTO_ENABLED=true
BOT_MOOD_DB_PATH=./data/emotion.sqlite3
BOT_MOOD_DECAY_MINUTES=180
BOT_MOOD_SENSITIVITY=1.0
BOT_MOOD_PROACTIVE_MIN_SOCIABILITY=35
BOT_MOOD_COUPLING=1.0

# Scheduled posts (config/schedules.json). Separate quota from
# BOT_PROACTIVE_DAILY_LIMIT so random chat and cron jobs cannot starve each other.
BOT_JOB_DAILY_LIMIT=6
BOT_JOB_COOLDOWN_MINUTES=30
BOT_JOB_FRESHNESS_MINUTES=180
BOT_JOB_MAX_CHARS=150
BOT_ACTIVE_START_HOUR=7
BOT_ACTIVE_END_HOUR=23

# Backpressure. The bot has two queues, both bounded, both dropping-and-counting
# rather than growing without limit. Inbound frames are dispatched one serial
# lane per group so a busy group cannot interleave its own replies; the
# observation queue carries post-reply affection/mood assessment, which is
# advisory and at-most-once.
BOT_ONEBOT_INBOUND_BACKLOG=64
BOT_ONEBOT_MAX_LANES=32
BOT_ONEBOT_REQUEST_TIMEOUT=20.0
BOT_ONEBOT_MAX_FRAME_KB=1024
BOT_OBSERVER_QUEUE_SIZE=256
BOT_OBSERVER_WORKERS=1
BOT_OBSERVER_DEDUPE=4096

# Long-term memory (qunbot/memory/). Leave the provider empty for lexical-only
# retrieval — the bot starts and recalls fine without any embedding service.
# "hash" is a local, dependency-free provider for smoke-testing the vector path.
# The openai provider calls an OpenAI-compatible /embeddings endpoint.
BOT_MEMORY_EMBEDDING_PROVIDER=
BOT_MEMORY_EMBEDDING_BASE_URL=
BOT_MEMORY_EMBEDDING_API_KEY=
BOT_MEMORY_EMBEDDING_MODEL=
BOT_MEMORY_EMBEDDING_DIM=256

# ---------------------------------------------------------------------------
# Behaviour extensions. Each needs its name in BOT_EXTENSIONS *and* its own
# enabled flag. This example enables group slang and group rhythm; removing
# either name disables its code without affecting the core bot.
# ---------------------------------------------------------------------------

# Per-turn phrasing hint (qunbot/extensions/persona/). Never touches
# config/persona.md; expires on its own and falls back to the baseline voice.
BOT_PERSONA_ENABLED=true
BOT_PERSONA_TTL_MINUTES=30
# Scan group dialogue on a cost-limited timer. In auto mode it selects only
# real, delivered, short bot exchanges, replacing one example in the marked
# section of persona.md; the stable identity and rules are never rewritten.
BOT_PERSONA_PROPOSALS_ENABLED=true
BOT_PERSONA_AUTO_EXAMPLES_ENABLED=true
BOT_PERSONA_PROPOSAL_INTERVAL_HOURS=6
BOT_PERSONA_PROPOSAL_MIN_MESSAGES=20
BOT_PERSONA_PROPOSAL_WINDOW_MESSAGES=60

# Reply decision (qunbot/extensions/reply_policy/). Off = answer only when
# @-ed. "mention_only" is the same rule expressed as a policy; "room" reads
# the room and abstains far more often.
BOT_REPLY_POLICY_ENABLED=false
BOT_REPLY_POLICY_MODE=mention_only
BOT_REPLY_POLICY_THRESHOLD=0.5
BOT_REPLY_POLICY_COOLDOWN_SECONDS=20
BOT_REPLY_POLICY_ENGAGED_SECONDS=600
BOT_REPLY_POLICY_BURST_SECONDS=20
BOT_REPLY_POLICY_BURST_COUNT=5
BOT_REPLY_POLICY_CROWD_SPEAKERS=3
BOT_REPLY_POLICY_BOT_NAMES=
# Admission control happens before the model call. Mentions are strong signals,
# but repeated low-value pursuit decays exponentially and still consumes a
# bounded daily pool only after a reply is actually delivered.
BOT_REPLY_POLICY_MENTION_PROBABILITY=0.85
BOT_REPLY_POLICY_AMBIENT_PROBABILITY=0.25
BOT_REPLY_POLICY_QUESTION_PROBABILITY=0.70
BOT_REPLY_POLICY_AFTER_REPLY_PROBABILITY=0.98
BOT_REPLY_POLICY_AFTER_REPLY_SECONDS=300
BOT_REPLY_POLICY_DAILY_GROUP_LIMIT=20
BOT_REPLY_POLICY_DAILY_USER_LIMIT=6
BOT_REPLY_POLICY_DECAY_HALF_LIFE_SECONDS=900
BOT_REPLY_POLICY_PURSUIT_WINDOW_SECONDS=300
BOT_REPLY_POLICY_DECAY_STRENGTH=0.45
BOT_REPLY_POLICY_REPEAT_MULTIPLIER=0.20

# Group slang (qunbot/extensions/slang/). Learns this group's own vocabulary
# from reading it; candidates must pass confidence and review gates before use.
# Reviewing happens in a local file, never through chat.
BOT_SLANG_ENABLED=true
BOT_SLANG_SCAN_INTERVAL_SECONDS=900
BOT_SLANG_WINDOW_MESSAGES=200
# Storage floor: a term at/above this count is kept, singletons included, so a
# sparse-but-steady term can accumulate across scans. Promotion floor: below
# this it is counted but never glossed, injected or offered for review.
BOT_SLANG_STORE_OCCURRENCES=1
BOT_SLANG_MIN_OCCURRENCES=3
BOT_SLANG_DECAY_HALF_LIFE_SECONDS=2592000
# Meaning inference. The only part of this package that calls a model, and the
# only bound on what learning costs: the model client is built without a budget
# policy, so these gates are load-bearing. A term is not inferred until it has
# been seen BOT_SLANG_INFER_THRESHOLDS[0] times.
BOT_SLANG_GLOSS_ENABLED=true
BOT_SLANG_GLOSS_INTERVAL_SECONDS=3600
BOT_SLANG_GLOSS_BATCH=12
BOT_SLANG_GLOSS_MAX_PER_SCAN=24
BOT_SLANG_INFER_THRESHOLDS=3,6,10,20,40,60,100
BOT_SLANG_LLM_FALLBACK=true
BOT_SLANG_MAX_MEANING_CHARS=24
# Off: a deployer's correction is not the model's to revise.
BOT_SLANG_OVERWRITE_HUMAN_MEANINGS=false
BOT_SLANG_MAX_TERM_CHARS=12
BOT_SLANG_MAX_NGRAM=4
BOT_SLANG_MAX_CANDIDATES=400
BOT_SLANG_MAX_MESSAGE_CHARS=200
BOT_SLANG_MAX_SAMPLES=5
BOT_SLANG_MAX_TERMS=24
BOT_SLANG_UNDERSTAND_CONFIDENCE=0.7
BOT_SLANG_IMITATE_CONFIDENCE=0.75
BOT_SLANG_ALLOW_UNREVIEWED=true
BOT_SLANG_ALLOW_IMITATION=true
BOT_SLANG_REVIEW_PATH=./config/slang_review.json
BOT_SLANG_WORDLIST_PATH=

# World perception (qunbot/extensions/world_context/). Three independent
# providers; the clock needs nothing, weather needs a key and is skipped
# entirely without one, replay reads memories through the memory port.
BOT_WORLD_TIME_ENABLED=false
BOT_WORLD_TIMEZONE=
BOT_WORLD_WEATHER_ENABLED=false
BOT_WORLD_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
BOT_WORLD_WEATHER_API_KEY=
BOT_WORLD_WEATHER_CITY=
BOT_WORLD_WEATHER_REFRESH_MINUTES=30
BOT_WORLD_WEATHER_TIMEOUT_SECONDS=5.0
BOT_WORLD_REPLAY_ENABLED=false
BOT_WORLD_REPLAY_LIMIT=3

# Expression style (qunbot/extensions/style_echo/). With an empty roster it
# derives a temporary group-level rhythm from the existing message ledger,
# without storing separate individual samples. A roster explicitly opts into
# per-person sample storage for the named users only.
BOT_STYLE_ECHO_ENABLED=true
BOT_STYLE_ECHO_ALLOWED_USERS=
BOT_STYLE_ECHO_MAX_SAMPLES=40
BOT_STYLE_ECHO_MIN_SAMPLES=5
BOT_STYLE_ECHO_POLL_SECONDS=120
BOT_STYLE_ECHO_RETENTION_DAYS=30
# The per-person provider caches its profile; group mode updates after replies
# and on a timer. 0 disables the per-person cache.
BOT_STYLE_ECHO_CACHE_SECONDS=300

# QQ group administration (qunbot/extensions/qq_admin/). The bot account must
# itself be a QQ group owner/admin for NapCat to execute moderation actions.
# Only these callers may ask the model to mute or mark essence; leave empty to
# disable all chat-triggered write actions while retaining file lookup/welcome.
BOT_QQ_ADMIN_OPERATOR_IDS=
BOT_QQ_ADMIN_MAX_MUTE_SECONDS=600
# Keyword rules are deterministic and checked before any model call. A request
# matching neither side stays pending unless DEFAULT_APPROVE is explicitly on.
BOT_QQ_ADMIN_JOIN_REVIEW_ENABLED=false
BOT_QQ_ADMIN_JOIN_APPROVE_KEYWORDS=
BOT_QQ_ADMIN_JOIN_REJECT_KEYWORDS=
BOT_QQ_ADMIN_JOIN_DEFAULT_APPROVE=false
BOT_QQ_ADMIN_WELCOME_ENABLED=true
# Bot 可自主提出头衔，但不能直接授予；本人同意或唯一群友票达到阈值后执行。
BOT_QQ_ADMIN_TITLE_ENABLED=true
BOT_QQ_ADMIN_TITLE_VOTE_THRESHOLD=3
BOT_QQ_ADMIN_TITLE_PROPOSAL_SECONDS=600
BOT_QQ_ADMIN_TITLE_MAX_CHARS=6

# QQ 官方频道（Guild/Channel），与 NapCat 普通 QQ 群是两套通道。
BOT_QQ_CHANNEL_ENABLED=false
BOT_QQ_CHANNEL_APP_ID=
BOT_QQ_CHANNEL_APP_SECRET=
BOT_QQ_CHANNEL_SANDBOX=false
# 只有这些当前 NapCat 会话中的 QQ 号能授权频道写操作；留空即只读。
BOT_QQ_CHANNEL_OPERATOR_IDS=
BOT_QQ_CHANNEL_TIMEOUT_SECONDS=15

# Required by jobs with "action":"poster". Also used to draw the countdown.
BOT_EXAM_DATE=2026-12-19
BOT_POSTER_FONT=

# Outbound media limits. An oversized image is dropped and the text still
# goes out; a reply never fails because an attachment was too big.
BOT_MEDIA_MAX_IMAGE_BYTES=4194304
BOT_MEDIA_MAX_URL_CHARS=2048

BOT_SKILLS_PATH=./skills
BOT_PERSONA_PATH=./config/persona.md
BOT_SCHEDULES_PATH=./config/schedules.json
BOT_MEMES_PATH=./memes
# 普通文字回复命中语义词时，附带 QQ 原生 face 消息段的概率。
BOT_MEDIA_QQ_FACE_PROBABILITY=0.18
# Planner's final voice gate (includes model-requested voice), not an extra boost.
BOT_MEDIA_CASUAL_VOICE_PROBABILITY=0.20
BOT_MEDIA_FOLLOWUP_MEME_PROBABILITY=0.40
BOT_MEDIA_RANDOM_MEME_PROBABILITY=0.00
BOT_REACTION_ENABLED=true
BOT_REACTION_PROBABILITY=0.65
BOT_REACTION_COOLDOWN_SECONDS=4
BOT_REACTION_DAILY_GROUP_LIMIT=80
BOT_REACTION_DAILY_USER_LIMIT=20
BOT_QUOTE_ENABLED=true
BOT_QUOTE_PROBABILITY=0.78
BOT_HUMANIZED_PACING_ENABLED=true
BOT_HUMANIZED_PACING_BASE_SECONDS=0.35
BOT_HUMANIZED_PACING_PER_CHAR_SECONDS=0.018
BOT_HUMANIZED_PACING_MAX_SECONDS=2.4
BOT_HUMANIZED_PACING_FOLLOWUP_SECONDS=0.65
BOT_REPEAT_PROBABILITY=0.68
BOT_REPEAT_COOLDOWN_SECONDS=90
BOT_REPEAT_DAILY_GROUP_LIMIT=20
BOT_REPEAT_CONTENT_COOLDOWN_SECONDS=21600
BOT_POKE_ENABLED=true
BOT_POKE_COUNTER_PROBABILITY=0.50
BOT_POKE_COOLDOWN_SECONDS=25
BOT_POKE_DAILY_USER_LIMIT=8
BOT_POKE_FOLLOW_WINDOW_SECONDS=45
BOT_POKE_FOLLOW_DISTINCT_USERS=3
BOT_POKE_FOLLOW_PROBABILITY=0.75
BOT_POKE_FOLLOW_COOLDOWN_SECONDS=180
BOT_REPLY_SEGMENT_MAX_CHARS=180
BOT_TTS_PROVIDER=cosyvoice
# Add voice to BOT_EXTENSIONS to enable speech; no client exists while disabled.
BOT_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BOT_TTS_API_KEY=replace-with-rotated-dashscope-key
BOT_TTS_MODEL=cosyvoice-v3-flash
BOT_TTS_VOICE=longfeifei_v3
