[importlinter]
root_package = qqbot

[importlinter:contract:scene]
name = Scene policy has no infrastructure dependencies
type = forbidden
source_modules = qqbot.agent.conversation.channels
forbidden_modules =
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap
    qqbot.agent.service

[importlinter:contract:audience]
name = Skill audience policy is independent of runtime orchestration
type = forbidden
source_modules = qqbot.agent.skills.audience
forbidden_modules =
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap
    qqbot.agent.orchestrator
    qqbot.agent.service

[importlinter:contract:cognition]
name = Cognitive decisions do not depend on concrete adapters
type = forbidden
source_modules = qqbot.agent.cognition
forbidden_modules =
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap
    qqbot.agent.orchestrator
    qqbot.agent.service

[importlinter:contract:contracts]
name = Shared contracts are below all runtime packages
type = forbidden
source_modules = qqbot.contracts
forbidden_modules =
    qqbot.agent
    qqbot.actions
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap

[importlinter:contract:orchestration]
name = The Agent loop depends on ports rather than concrete implementations
type = forbidden
source_modules =
    qqbot.agent.orchestrator
    qqbot.agent.service
forbidden_modules =
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap

[importlinter:contract:skills]
name = Skill definitions cannot register concrete platform capabilities
type = forbidden
source_modules = qqbot.agent.skills
forbidden_modules =
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap

[importlinter:contract:observations]
name = Reply observation lifecycle owns no adapters or conversation service
type = forbidden
source_modules = qqbot.agent.observation
forbidden_modules =
    qqbot.agent.service
    qqbot.infrastructure
    qqbot.features
    qqbot.interfaces
    qqbot.bootstrap
