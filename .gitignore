.env
.env.*
!.env.example
.venv/
# Runtime state only. Anchored to the repo root on purpose: an unanchored
# "data/" also swallows package data directories such as
# qunbot/extensions/slang/data/, which is source, not state.
/data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.log
/outputs/
# Offline experiment reports and the HTML rendered from them. Both are derived
# from data/private/ and both are one command to rebuild; the console shows an
# empty state with that command when the report is absent.
/experiments/
/config/schedules.json
/config/proactive_groups.json
/config/slang_review.json
# Third-party media stays local; retain provenance without redistributing files.
/memes/astrbot-official-01/*
!/memes/astrbot-official-01/SOURCE.md
/qunbot/extensions/exam_poster/campuses/
.DS_Store
.pytest_cache/
# Scratch dir pytest is pointed at here; the sandbox forbids its default
# location, so runs use --basetemp=.pytest_tmp.
.pytest_tmp/
*.egg-info/
/build/
/dist/
__pycache__/
*.pyc

# Parallel agent worktrees
.claude/worktrees/
.quality/
.veritygate/run.lock/
.veritygate/.gitkeep
.mcp.json

# Test-first quality toolchain and generated reports
node_modules/
.coverage
.import_linter_cache/
.pytest_tmp_*/
