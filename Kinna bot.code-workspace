      ".ruff_cache": true,
      ".import_linter_cache": true,
      "build": true,
      "dist": true,
      ".coverage": true
    },
    "search.exclude": {
      "**/__pycache__": true,
      ".venv": true,
      ".quality": true,
      ".pytest_tmp*": true,
      "data": true,
      "experiments": true,
      "build": true
    },
    "explorer.sortOrder": "default"
  }
