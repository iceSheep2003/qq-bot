    "window.title": "Kinna bot · ${activeEditorShort} · ${appName}",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.egg-info": true,
      ".venv": true,
